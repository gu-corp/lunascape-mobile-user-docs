{
  "name": "my-website",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "npm run compile-scss && docusaurus build",
    "build:css": "sass src/scss/custom.scss src/css/custom.css --style=expanded --source-map",
    "compile-scss": "sass src/scss/custom.scss src/css/custom.css --style=compressed --no-source-map",
    "watch-scss": "sass src/scss/custom.scss src/css/custom.css --style=expanded --source-map --watch",
    "swizzle": "docusaurus swizzle",
    "deploy": "npm run compile-scss && docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids"
  },
  "dependencies": {
    "@docusaurus/core": "3.8.1",
    "@docusaurus/preset-classic": "3.8.1",
    "@docusaurus/theme-mermaid": "^3.8.1",
    "@headlessui/react": "^2.2.7",
    "@heroicons/react": "^2.2.0",
    "@mdx-js/react": "^3.0.0",
    "docusaurus-plugin-image-zoom": "^3.0.1",
    "docusaurus-plugin-sass": "^0.2.6",
    "lucide-react": "^0.548.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sass": "^1.91.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.8.1",
    "@docusaurus/types": "3.8.1"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=18.0"
  }
}
